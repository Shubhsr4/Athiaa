# Supabase Secrets required for Athia Edge Functions
# Set these in Supabase CLI or Dashboard using:
# supabase secrets set RESEND_API_KEY=... RAZORPAY_WEBHOOK_SECRET=...

# Razorpay Webhook Secret (Matches secret in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Resend API Key for Email Delivery
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Athiaa Donations <donations@athiaango.org>

# Static NGO 80G & Legal Identity Values (Configurable without modifying code)
NGO_LEGAL_NAME=ATHIAA ANIMAL WELFARE FOUNDATION
NGO_ADDRESS=123 Rescue Way, South Extension, New Delhi - 110001, India
NGO_PAN=AABTA1234F
NGO_80G_REG_NUMBER=CIT-EXPT/80G/ATH-ND2025
NGO_12A_REG_NUMBER=12A/TRUST-REG/25B084

# MSG91 OTP Integration
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
